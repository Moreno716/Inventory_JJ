---
import "@/styles/inventory.css";
import InventarioForm from "@/components/InventarioForm.astro";
import InventarioTable from "@/components/InventarioTable.astro";
import StockAlertsWidget from "@/components/StockAlertsWidget.astro";
import CategoryDistributionWidget from "@/components/CategoryDistributionWidget.astro";
import KpiCards from "@/components/KpiCards.astro";
import InventoryModals from "@/components/InventoryModals.astro";
import { validateRouteAccess } from "@/utils/permissionUtils";

if (!validateRouteAccess()) {
  // En desarrollo siempre permite, pero se deja aquí para futura autenticación
}
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestión de Inventario | Aliados</title>
  </head>
  <body class="relative min-h-screen bg-[#f8fafc] text-slate-800 antialiased selection:bg-blue-100 selection:text-[#001A6E]">
    
    <!-- Orbes de luz ambiental -->
    <div class="glow-orb bg-[#001A6E] w-[450px] h-[450px] top-[-150px] left-[-200px]"></div>
    <div class="glow-orb bg-[#00D2C4] w-[400px] h-[400px] top-[30%] right-[-150px]"></div>
    <div class="glow-orb bg-[#0b2f95] w-[350px] h-[350px] bottom-[-150px] left-[15%]"></div>
    
    <!-- Patrón de cuadrícula superpuesta -->
    <div class="grid-overlay"></div>

    <main class="relative z-10 mx-auto max-w-[1800px] px-4 py-5 sm:px-6 sm:py-6 lg:px-10 lg:py-8">
      <!-- Diseño dividido de panel responsivo -->
      <div class="grid grid-cols-1 xl:grid-cols-[400px_1fr] gap-5 lg:gap-8 items-start">
        
        <!-- ================= BARRA LATERAL (PANEL IZQUIERDO) ================= -->
        <aside class="flex flex-col gap-4 xl:sticky xl:top-6 xl:max-h-[calc(100vh-3rem)] xl:overflow-y-auto no-scrollbar pb-2">
          
          <!-- Tarjeta de marca / encabezado -->
          <div class="rounded-2xl border border-slate-300/80 bg-white/70 p-4 sm:p-5 shadow-[0_8px_30px_rgba(0,26,110,0.015)] backdrop-blur-md">
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 sm:h-13 sm:w-13 shrink-0 items-center justify-center rounded-xl bg-gradient-to-tr from-[#001A6E] to-[#0b2f95] text-white shadow-lg shadow-blue-900/10">
                <svg class="h-5 w-5 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-[9px] sm:text-[10px] font-extrabold uppercase tracking-[0.25em] text-blue-600 truncate">Aliados Facilísimo</p>
                <h1 class="text-base sm:text-lg font-extrabold tracking-tight text-slate-900 leading-tight mt-0.5">Gestión de Inventario</h1>
              </div>
            </div>
            
            <div class="mt-4 pt-3 border-t border-slate-200/80 flex items-center justify-between gap-2 flex-wrap">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-[10px] sm:text-xs font-bold text-emerald-700 border border-emerald-200/30">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 active-pulse"></span>
                Base de datos local
              </span>
              <a href="/" class="group inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-[10px] sm:text-xs font-extrabold text-slate-600 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900 active:scale-95">
                <svg class="h-3 w-3 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Volver
              </a>
            </div>
          </div>
          
          <!-- Controles de acciones y búsqueda (El formulario maneja el activador del modal y la entrada de búsqueda) -->
          <InventarioForm />

          <!-- Widget: Alertas de Stock -->
          <StockAlertsWidget />

          <!-- Widget: Distribución por Categorías -->
          <CategoryDistributionWidget />
          
        </aside>

  
        <section class="flex flex-col gap-4 sm:gap-5 min-w-0 xl:max-h-[calc(100vh-3rem)] xl:overflow-y-auto no-scrollbar pb-2">
          
        
          <KpiCards />

          <!-- Tabla principal y widgets inferiores -->
          <InventarioTable />
        </section>
        
      </div>
    </main>

    <InventoryModals />
  </body>
</html>
