---
---
<div id="tableMessage" class="text-xs font-semibold text-center h-5 mb-2 transition-all"></div>

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

  <!-- Encabezado con conteo -->
  <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between">
    <h2 class="text-sm font-bold text-slate-700">Productos</h2>
    <span id="productCount" class="text-xs text-slate-400 font-semibold"></span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-slate-100 bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-400">
          <th class="px-4 py-3">Producto</th>
          <th class="hidden sm:table-cell px-4 py-3">Categoría</th>
          <th class="hidden sm:table-cell px-4 py-3 text-right">Precio</th>
          <th class="px-4 py-3 text-right">Acciones</th>
        </tr>
      </thead>
      <tbody id="inventarioBody" class="divide-y divide-slate-100">
        <tr>
          <td colspan="4" class="px-5 py-14 text-center">
            <div class="flex flex-col items-center gap-3 text-slate-400">
              <svg class="h-7 w-7 animate-spin text-[#001A6E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H18.2"/>
              </svg>
              <p class="text-sm font-medium">Cargando...</p>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

</div>

<script>
  let productosActuales: any[] = [];
  let categoriaActiva = '';

  const tableMessage = document.getElementById('tableMessage') as HTMLElement;
  const searchInput = document.getElementById('tableSearch') as HTMLInputElement | null;
  const productCount = document.getElementById('productCount') as HTMLElement;

  function mostrarMensaje(msg: string, tipo: 'success' | 'error') {
    tableMessage.textContent = msg;
    tableMessage.className = `text-xs font-semibold text-center h-5 mb-2 ${tipo === 'success' ? 'text-emerald-600' : 'text-rose-600'}`;
    setTimeout(() => {
      tableMessage.textContent = '';
      tableMessage.className = 'text-xs font-semibold text-center h-5 mb-2';
    }, 4000);
  }

  function actualizarStats() {
    const totalProductsEl = document.getElementById('headerStatProducts');
    if (totalProductsEl) totalProductsEl.textContent = productosActuales.length.toString();
  }

  function renderizarTabla() {
    const tbody = document.getElementById('inventarioBody');
    if (!tbody) return;

    const query = searchInput?.value.toLowerCase().trim() ?? '';

    const filtrados = productosActuales.filter(item => {
      const matchSearch = !query ||
        (item.nombre || '').toLowerCase().includes(query) ||
        (item.categoria || '').toLowerCase().includes(query);
      const matchCat = !categoriaActiva || (item.categoria || '').trim() === categoriaActiva;
      return matchSearch && matchCat;
    });

    if (productCount) {
      productCount.textContent = filtrados.length === productosActuales.length
        ? `${productosActuales.length} en total`
        : `${filtrados.length} de ${productosActuales.length}`;
    }

    if (filtrados.length === 0) {
      const emptyMsg = productosActuales.length === 0
        ? 'Aún no hay productos. ¡Agrega el primero!'
        : 'No se encontraron productos.';
      tbody.innerHTML = `
        <tr>
          <td colspan="4" class="px-5 py-14 text-center">
            <p class="text-sm text-slate-400 font-medium">${emptyMsg}</p>
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = filtrados.map(item => {
      const cat = item.categoria?.trim() || '';
      const precio = item.precio ? `$${Number(item.precio).toLocaleString('es-CO')}` : '—';
      const inicial = (item.nombre || 'P').charAt(0).toUpperCase();

      return `
        <tr class="group hover:bg-slate-50/70 transition-colors">
          <td class="px-4 py-3.5">
            <div class="flex items-center gap-3 min-w-0">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-50 font-extrabold text-sm text-[#001A6E] border border-blue-100 select-none">${inicial}</div>
              <div class="min-w-0">
                <div class="font-bold text-slate-800 truncate">${item.nombre}</div>
                ${cat ? `<div class="text-[11px] text-slate-400 mt-0.5 sm:hidden truncate">${cat}</div>` : ''}
                <div class="text-xs font-semibold text-slate-500 mt-0.5 sm:hidden">${precio}</div>
              </div>
            </div>
          </td>
          <td class="hidden sm:table-cell px-4 py-3.5">
            ${cat
              ? `<span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">${cat}</span>`
              : `<span class="text-slate-300 text-xs">—</span>`
            }
          </td>
          <td class="hidden sm:table-cell px-4 py-3.5 text-right font-bold text-slate-800">${precio}</td>
          <td class="px-4 py-3.5">
            <div class="flex items-center justify-end gap-2">
              <button
                title="Editar"
                class="edit-btn flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-500 shadow-sm transition hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700 active:scale-95"
                data-id="${item.id}"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                </svg>
              </button>
              <button
                title="Eliminar"
                class="delete-btn flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 bg-white text-rose-500 shadow-sm transition hover:border-rose-300 hover:bg-rose-50 hover:text-rose-700 active:scale-95"
                data-id="${item.id}"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');

    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        const item = productosActuales.find(p => String(p.id) === id);
        if (item) window.dispatchEvent(new CustomEvent('editarProducto', { detail: { producto: item } }));
      });
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        const id = Number((e.currentTarget as HTMLElement).dataset.id);
        window.dispatchEvent(new CustomEvent('eliminarProducto', { detail: { id } }));
      });
    });
  }

  async function cargarInventario() {
    try {
      const res = await fetch('/api/products');
      const data = await res.json();
      productosActuales = Array.isArray(data) ? data : [];
      actualizarStats();
      renderizarTabla();
    } catch {
      const tbody = document.getElementById('inventarioBody');
      if (tbody) tbody.innerHTML = `
        <tr><td colspan="4" class="px-5 py-8 text-center text-rose-500 text-sm font-semibold">Error al cargar los productos</td></tr>
      `;
    }
  }

  searchInput?.addEventListener('input', renderizarTabla);

  window.addEventListener('filtrarCategoria', (e: any) => {
    categoriaActiva = e.detail.categoria;
    renderizarTabla();
  });

  window.addEventListener('inventarioActualizado', cargarInventario);

  cargarInventario();
</script>
