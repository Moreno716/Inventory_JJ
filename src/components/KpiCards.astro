---
// Componente para las tarjetas KPI de estadísticas
---
<div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
            
  <!-- KPI 1: Productos -->
  <div class="interactive-card flex items-center gap-3 sm:gap-4 rounded-2xl border border-slate-300/80 bg-white/70 p-4 sm:p-5 shadow-[0_8px_30px_rgba(0,0,0,0.01)] backdrop-blur-md">
    <div class="flex h-10 w-10 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-xl sm:rounded-2xl bg-blue-50 text-blue-600 border border-blue-100/50 shadow-sm">
      <svg class="h-5 w-5 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
      </svg>
    </div>
    <div class="min-w-0">
      <p class="text-[9px] sm:text-[10px] font-bold uppercase tracking-widest text-slate-400">Productos</p>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-800 mt-0.5 leading-none" id="statTotalProducts">-</h3>
      <p class="hidden sm:block text-[10px] text-slate-400 mt-1">en catalogo</p>
    </div>
  </div>

  <!-- KPI 2: Stock Total -->
  <div class="interactive-card flex items-center gap-3 sm:gap-4 rounded-2xl border border-slate-300/80 bg-white/70 p-4 sm:p-5 shadow-[0_8px_30px_rgba(0,0,0,0.01)] backdrop-blur-md">
    <div class="flex h-10 w-10 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-xl sm:rounded-2xl bg-emerald-50 text-emerald-600 border border-emerald-100/50 shadow-sm">
      <svg class="h-5 w-5 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
      </svg>
    </div>
    <div class="min-w-0">
      <p class="text-[9px] sm:text-[10px] font-bold uppercase tracking-widest text-slate-400">Stock Total</p>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-800 mt-0.5 leading-none" id="statTotalStock">-</h3>
      <p class="hidden sm:block text-[10px] text-slate-400 mt-1">unidades físicas</p>
    </div>
  </div>

  <!-- KPI 3: Valor Total -->
  <div class="interactive-card flex items-center gap-3 sm:gap-4 rounded-2xl border border-slate-300/80 bg-white/70 p-4 sm:p-5 shadow-[0_8px_30px_rgba(0,0,0,0.01)] backdrop-blur-md">
    <div class="flex h-10 w-10 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-xl sm:rounded-2xl bg-amber-50 text-amber-600 border border-amber-100/50 shadow-sm">
      <svg class="h-5 w-5 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M12 8H12m0 8h.01"></path>
      </svg>
    </div>
    <div class="min-w-0">
      <p class="text-[9px] sm:text-[10px] font-bold uppercase tracking-widest text-slate-400">Valor Total</p>
      <h3 class="text-lg sm:text-2xl font-extrabold text-slate-800 mt-0.5 leading-none" id="statTotalValue">-</h3>
      <p class="hidden sm:block text-[10px] text-slate-400 mt-1">precio × cantidad</p>
    </div>
  </div>

  <!-- KPI 4: Categorías -->
  <div class="interactive-card flex items-center gap-3 sm:gap-4 rounded-2xl border border-slate-300/80 bg-white/70 p-4 sm:p-5 shadow-[0_8px_30px_rgba(0,0,0,0.01)] backdrop-blur-md">
    <div class="flex h-10 w-10 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-xl sm:rounded-2xl bg-indigo-50 text-indigo-600 border border-indigo-100/50 shadow-sm">
      <svg class="h-5 w-5 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
    </div>
    <div class="min-w-0">
      <p class="text-[9px] sm:text-[10px] font-bold uppercase tracking-widest text-slate-400">Categorías</p>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-800 mt-0.5 leading-none" id="statCategories">-</h3>
      <p class="hidden sm:block text-[10px] text-slate-400 mt-1">líneas activas</p>
    </div>
  </div>

</div>
