---
// Componente que incluye los modales de agregar, editar y eliminar
---

<!-- ================= MODAL AÑADIR PRODUCTO ================= -->
<div 
  id="addProductModal" 
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-900/40 px-4 py-8 backdrop-blur-sm transition-opacity duration-300"
>
  <div 
    class="w-full max-w-3xl transform rounded-2xl border border-slate-200 bg-white p-8 shadow-2xl transition-all duration-300 scale-95"
    style="animation: modalFadeIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;"
  >
    <div class="mb-6 flex items-start justify-between">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-blue-700">
          Catálogo
        </span>
        <h3 class="text-xl font-extrabold text-slate-900 mt-1">Registrar Nuevo Producto</h3>
      </div>
      <button 
        id="closeAddModal" 
        type="button" 
        class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-600"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <form id="inventarioForm" class="space-y-5">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        
        <!-- Nombre -->
        <div class="flex flex-col gap-1.5">
          <label for="nombre" class="text-xs font-bold text-slate-600">Nombre del producto <span class="text-red-500">*</span></label>
          <input 
            type="text" 
            id="nombre" 
            placeholder="Ej. Impresora láser" 
            required 
            class="w-full rounded-xl border-2 border-slate-300/80 bg-slate-50/50 px-4 py-3 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100" 
          />
        </div>

        <!-- Cantidad -->
        <div class="flex flex-col gap-1.5">
          <label for="cantidad" class="text-xs font-bold text-slate-600">Cantidad disponible <span class="text-red-500">*</span></label>
          <div class="flex items-center gap-2">
            <button type="button" id="decreaseCantidad"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border-2 border-slate-300/80 bg-slate-50 text-slate-700 text-lg font-bold transition hover:border-blue-400 hover:bg-blue-50 hover:text-blue-700 active:scale-95"
            >−</button>
            <input 
              type="number" 
              id="cantidad" 
              placeholder="0" 
              required 
              min="0" 
              class="w-full rounded-xl border-2 border-slate-300/80 bg-slate-50/50 px-4 py-3 text-center text-sm font-bold text-slate-800 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100" 
            />
            <button type="button" id="increaseCantidad"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border-2 border-slate-300/80 bg-slate-50 text-slate-700 text-lg font-bold transition hover:border-blue-400 hover:bg-blue-50 hover:text-blue-700 active:scale-95"
            >+</button>
          </div>
        </div>

        <!-- Categoría -->
        <div class="flex flex-col gap-1.5">
          <label for="categoria" class="text-xs font-bold text-slate-600">Categoría</label>
          <input 
            type="text" 
            id="categoria" 
            placeholder="Ej. Impresión" 
            class="w-full rounded-xl border-2 border-slate-300/80 bg-slate-50/50 px-4 py-3 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100" 
          />
        </div>

        <!-- Precio -->
        <div class="flex flex-col gap-1.5">
          <label for="precio" class="text-xs font-bold text-slate-600">Precio Unitario ($)</label>
          <input 
            type="number" 
            id="precio" 
            placeholder="Ej. 150.00" 
            step="0.01" 
            min="0" 
            class="w-full rounded-xl border-2 border-slate-300/80 bg-slate-50/50 px-4 py-3 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100" 
          />
        </div>
      </div>

      <!-- Descripción -->
      <div class="flex flex-col gap-1.5">
        <label for="descripcion" class="text-xs font-bold text-slate-600">Descripción detallada</label>
        <textarea 
          id="descripcion" 
          placeholder="Añade detalles relevantes del producto (opcional)..." 
          rows="3" 
          class="w-full rounded-xl border-2 border-slate-300/80 bg-slate-50/50 px-4 py-3 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
        ></textarea>
      </div>

      <!-- Acciones del formulario -->
      <div class="flex flex-col gap-2 pt-3 sm:flex-row sm:justify-end">
        <button 
          id="cancelAddModal" 
          type="button" 
          class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 transition hover:bg-slate-50 active:scale-95"
        >
          Cancelar
        </button>
        
        <button 
          type="submit" 
          id="submitBtn"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#001A6E] to-[#0b2f95] px-6 py-2.5 text-sm font-bold text-white shadow-lg shadow-blue-900/10 transition duration-300 hover:shadow-blue-900/20 disabled:opacity-50 active:scale-95"
        >
          Guardar Producto
        </button>
      </div>

      <!-- Mensaje de estado en línea -->
      <div id="message" class="text-center text-xs font-semibold mt-2"></div>
    </form>
  </div>
</div>

<!-- ================= MODAL EDITAR PRODUCTO ================= -->
<div 
  id="editModal" 
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-900/40 px-4 py-8 backdrop-blur-sm"
>
  <div 
    class="w-full max-w-3xl rounded-2xl border border-slate-200 bg-white p-8 shadow-2xl scale-95"
    style="animation: modalFadeIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;"
  >
    <div class="mb-5 flex items-start justify-between">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-blue-700">
          Edición
        </span>
        <h3 class="text-xl font-extrabold text-slate-900 mt-1">Editar Producto</h3>
      </div>
      <button 
        type="button" 
        id="closeEditModal" 
        class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-600"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <form id="editProductForm" class="space-y-5">
      <input type="hidden" id="editId" />
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        
        <!-- Nombre -->
        <div class="flex flex-col gap-1.5">
          <label for="editNombre" class="text-xs font-bold text-slate-600">Nombre del producto <span class="text-red-500">*</span></label>
          <input 
            id="editNombre" 
            type="text" 
            placeholder="Ej. Impresora láser" 
            required 
            class="w-full rounded-xl border-2 border-slate-300/80 bg-slate-50/50 px-4 py-3 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100" 
          />
        </div>

        <!-- Cantidad -->
        <div class="flex flex-col gap-1.5">
          <label for="editCantidad" class="text-xs font-bold text-slate-600">Cantidad disponible <span class="text-red-500">*</span></label>
          <div class="flex items-center gap-2">
            <button type="button" id="editDecreaseCantidad"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border-2 border-slate-300/80 bg-slate-50 text-slate-700 text-lg font-bold transition hover:border-blue-400 hover:bg-blue-50 hover:text-blue-700 active:scale-95"
            >−</button>
            <input 
              id="editCantidad" 
              type="number" 
              min="0" 
              placeholder="0" 
              required 
              class="w-full rounded-xl border-2 border-slate-300/80 bg-slate-50/50 px-4 py-3 text-center text-sm font-bold text-slate-800 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100" 
            />
            <button type="button" id="editIncreaseCantidad"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border-2 border-slate-300/80 bg-slate-50 text-slate-700 text-lg font-bold transition hover:border-blue-400 hover:bg-blue-50 hover:text-blue-700 active:scale-95"
            >+</button>
          </div>
        </div>

        <!-- Categoría -->
        <div class="flex flex-col gap-1.5">
          <label for="editCategoria" class="text-xs font-bold text-slate-600">Categoría</label>
          <input 
            id="editCategoria" 
            type="text" 
            placeholder="Ej. Impresión" 
            class="w-full rounded-xl border-2 border-slate-300/80 bg-slate-50/50 px-4 py-3 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100" 
          />
        </div>

        <!-- Precio -->
        <div class="flex flex-col gap-1.5">
          <label for="editPrecio" class="text-xs font-bold text-slate-600">Precio Unitario ($)</label>
          <input 
            id="editPrecio" 
            type="number" 
            min="0" 
            step="0.01" 
            placeholder="Ej. 150.00" 
            class="w-full rounded-xl border-2 border-slate-300/80 bg-slate-50/50 px-4 py-3 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100" 
          />
        </div>
      </div>

      <!-- Descripción -->
      <div class="flex flex-col gap-1.5">
        <label for="editDescripcion" class="text-xs font-bold text-slate-600">Descripción detallada</label>
        <textarea 
          id="editDescripcion" 
          placeholder="Añade una descripción relevante..." 
          rows="3" 
          class="w-full rounded-xl border-2 border-slate-300/80 bg-slate-50/50 px-4 py-3 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
        ></textarea>
      </div>

      <!-- Acciones -->
      <div class="flex flex-col gap-2 pt-3 sm:flex-row sm:justify-end">
        <button 
          type="button" 
          id="cancelEditBtn" 
          class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 transition hover:bg-slate-50 active:scale-95"
        >
          Cancelar
        </button>
        <button 
          type="submit" 
          class="rounded-xl bg-gradient-to-r from-[#001A6E] to-[#0b2f95] px-6 py-2.5 text-sm font-bold text-white shadow-lg shadow-blue-900/10 transition duration-300 hover:shadow-blue-900/20 active:scale-95"
        >
          Guardar Cambios
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ================= MODAL DE CONFIRMACIÓN DE ELIMINACIÓN ================= -->
<div 
  id="deleteConfirmModal" 
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-900/40 px-4 py-6 backdrop-blur-sm"
>
  <div 
    class="w-full max-w-md rounded-2xl border border-red-100 bg-white p-6 shadow-2xl scale-95"
    style="animation: modalFadeIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;"
  >
    <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-red-50 text-red-600">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
      </svg>
    </div>
    <h3 class="text-lg font-bold text-slate-900">¿Eliminar producto?</h3>
    <p class="mt-2 text-sm text-slate-500 leading-relaxed">
      Esta acción no se puede deshacer. El producto será borrado permanentemente del catálogo.
    </p>
    
    <div class="mt-6 flex gap-3">
      <button 
        type="button" 
        id="cancelDeleteBtn" 
        class="flex-1 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:bg-slate-50 active:scale-95"
      >
        Cancelar
      </button>
      <button 
        type="button" 
        id="confirmDeleteBtn" 
        class="flex-1 rounded-xl bg-gradient-to-r from-red-600 to-red-700 px-4 py-2.5 text-sm font-bold text-white shadow-lg shadow-red-200 transition duration-300 hover:shadow-red-300 active:scale-95"
      >
        Eliminar
      </button>
    </div>
  </div>
</div>

<script>
// Controles de cantidad - Modal de añadir
const cantidadInput = document.getElementById('cantidad') as HTMLInputElement;
document.getElementById('increaseCantidad')?.addEventListener('click', () => {
  const val = parseInt(cantidadInput.value) || 0;
  cantidadInput.value = String(val + 1);
});
document.getElementById('decreaseCantidad')?.addEventListener('click', () => {
  const val = parseInt(cantidadInput.value) || 0;
  if (val > 0) cantidadInput.value = String(val - 1);
});

// Controles de cantidad - Modal de edición
const editCantidadInput = document.getElementById('editCantidad') as HTMLInputElement;
document.getElementById('editIncreaseCantidad')?.addEventListener('click', () => {
  const val = parseInt(editCantidadInput.value) || 0;
  editCantidadInput.value = String(val + 1);
});
document.getElementById('editDecreaseCantidad')?.addEventListener('click', () => {
  const val = parseInt(editCantidadInput.value) || 0;
  if (val > 0) editCantidadInput.value = String(val - 1);
});
</script>

<style>
@keyframes modalFadeIn {
  from { opacity: 0; transform: scale(0.95) translateY(10px); }
  to   { opacity: 1; transform: scale(1)    translateY(0); }
}
</style>
